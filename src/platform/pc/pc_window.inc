/* Win32 window and input for the desktop build: a plain GDI window whose
 * client area IS the framebuffer (the software rasterizer fills it), mouse
 * as a real touch pointer, and the keyboard translated into what a phone
 * gives the game - a virtual stick plus taps on the combat pads drawn by
 * battle_render.inc. */
#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
#include <windows.h>
#include <windowsx.h>
#include <mmsystem.h>

#define PC_WIN_CLASS L"CubicBattle4PC"
#define PC_TOUCH_MOUSE 500

static HWND pc_hwnd = NULL;
static int pc_mouse_down = 0;  /* the left button is physically held */
static int pc_mouse_punch = 0; /* ...and this press became the punch, not a click */
static unsigned char pc_keys[256];
static uint32_t *pc_conv = NULL;
static int pc_conv_w = 0, pc_conv_h = 0;

static int pc_key_down(int vk) { return pc_keys[vk & 0xff] != 0; }

/* In an active fight the mouse is a weapon, not a pointer: the left button is
 * the punch anywhere on screen, so the cursor's raw touch is muted - it would
 * otherwise grab the joystick or quit the fight from the back button corner
 * mid-swing. Menus, the results tap ("tap to return") and the battle chat
 * keep clicking. */
static int pc_mouse_combat(void) {
    return game_pc_in_battle() && game_pc_finished() == 0.0 && !keyboard_visible();
}

static void pc_apply_held_input(void) {
    float dx = 0, dy = 0;
    if (keyboard_visible()) {
        pc_ctl_release_all();
        return;
    }
    if (pc_key_down('A') || pc_key_down(VK_LEFT))
        dx -= 1.0f;
    if (pc_key_down('D') || pc_key_down(VK_RIGHT))
        dx += 1.0f;
    if (pc_key_down('W') || pc_key_down(VK_UP))
        dy -= 1.0f;
    if (pc_key_down('S') || pc_key_down(VK_DOWN))
        dy += 1.0f;
    pc_ctl_stick(dx, dy);
    pc_ctl_attack(pc_mouse_punch && pc_mouse_combat());
    pc_ctl_block(pc_key_down('E'));
    pc_ctl_super(pc_key_down('Q'));
}

static void pc_blit(void) {
    HDC dc;
    RECT rc;
    int cw, ch;
    int x, y;
    if (!pc_hwnd || !g_frame.pixels)
        return;
    GetClientRect(pc_hwnd, &rc);
    cw = rc.right - rc.left;
    ch = rc.bottom - rc.top;
    if (cw < 1 || ch < 1)
        return;
    if (pc_conv_w != g_frame.width || pc_conv_h != g_frame.height) {
        free(pc_conv);
        pc_conv = (uint32_t *)malloc((size_t)g_frame.width * (size_t)g_frame.height * sizeof(uint32_t));
        pc_conv_w = g_frame.width;
        pc_conv_h = g_frame.height;
        if (!pc_conv)
            return;
    }
    for (y = 0; y < g_frame.height; y++) {
        const uint32_t *src = g_frame.pixels + (size_t)y * (size_t)g_frame.stride;
        uint32_t *dst = pc_conv + (size_t)y * (size_t)pc_conv_w;
        for (x = 0; x < g_frame.width; x++) {
            uint32_t c = src[x]; /* r | g<<8 | b<<16 | a<<24 */
            dst[x] = 0xff000000u | ((c & 0xff) << 16) | ((c >> 8) & 0xff00) | ((c >> 16) & 0xff);
        }
    }
    dc = GetDC(pc_hwnd);
    {
        BITMAPINFO bi;
        memset(&bi, 0, sizeof(bi));
        bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
        bi.bmiHeader.biWidth = pc_conv_w;
        bi.bmiHeader.biHeight = -pc_conv_h; /* top-down */
        bi.bmiHeader.biPlanes = 1;
        bi.bmiHeader.biBitCount = 32;
        bi.bmiHeader.biCompression = BI_RGB;
        /* COLORONCOLOR is the nearest-neighbour stretch: the window shows the
         * frame as drawn, with no blurred pixels. */
        SetStretchBltMode(dc, COLORONCOLOR);
        StretchDIBits(dc, 0, 0, cw, ch, 0, 0, pc_conv_w, pc_conv_h, pc_conv, &bi, DIB_RGB_COLORS, SRCCOPY);
    }
    ReleaseDC(pc_hwnd, dc);
}

static void pc_utf8_from_wchar(WCHAR wc, char *out, size_t cap) {
    wchar_t wbuf[2];
    int n;
    if (cap < 8)
        return;
    /* Surrogates arrive as two WM_CHAR calls; the game only needs ASCII names
     * plus Cyrillic, so lone surrogates are dropped. */
    if (wc >= 0xD800 && wc <= 0xDFFF) {
        out[0] = '\0';
        return;
    }
    wbuf[0] = (wchar_t)wc;
    wbuf[1] = 0;
    n = WideCharToMultiByte(CP_UTF8, 0, wbuf, 1, out, (int)cap - 1, NULL, NULL);
    out[n > 0 ? n : 0] = '\0';
}

static LRESULT CALLBACK pc_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
    switch (msg) {
    case WM_CLOSE:
        pc_quit = 1;
        return 0;
    case WM_DESTROY:
        pc_quit = 1;
        return 0;
    case WM_SIZE:
        if (wp != SIZE_MINIMIZED) {
            int w = LOWORD(lp), h = HIWORD(lp);
            if (w > 0 && h > 0) {
                phys_w = w;
                phys_h = h;
                screen_w = w;
                screen_h = h;
            }
        }
        return 0;
    case WM_MOUSEMOVE:
        if (pc_mouse_down && !pc_mouse_punch)
            pc_touch((float)GET_X_LPARAM(lp), (float)GET_Y_LPARAM(lp), 2, PC_TOUCH_MOUSE);
        return 0;
    case WM_LBUTTONDOWN:
        SetCapture(hwnd);
        pc_mouse_down = 1;
        /* In a fight the left button IS the punch; the raw cursor touch is
         * kept only for the chat controls (chat button, open chat panel). */
        pc_mouse_punch = pc_mouse_combat() &&
                         game_pc_battle_mouse_ui((float)GET_X_LPARAM(lp), (float)GET_Y_LPARAM(lp)) == 0;
        if (!pc_mouse_punch)
            pc_touch((float)GET_X_LPARAM(lp), (float)GET_Y_LPARAM(lp), 0, PC_TOUCH_MOUSE);
        return 0;
    case WM_LBUTTONUP:
        pc_mouse_down = 0;
        ReleaseCapture();
        if (!pc_mouse_punch)
            pc_touch((float)GET_X_LPARAM(lp), (float)GET_Y_LPARAM(lp), 1, PC_TOUCH_MOUSE);
        pc_mouse_punch = 0;
        return 0;
    case WM_KEYDOWN:
    case WM_SYSKEYDOWN:
        pc_keys[wp & 0xff] = 1;
        if (msg == WM_SYSKEYDOWN)
            return 0; /* Alt+Tab etc. stay with the system */
        if (wp == VK_F12) {
            (void)pc_write_bmp("cb4_shot.bmp", g_frame.pixels, g_frame.width, g_frame.height, g_frame.stride);
            ds_log("screenshot saved to cb4_shot.bmp");
        } else if (wp == VK_ESCAPE) {
            if (keyboard_visible())
                keyboard_hide();
            else
                (void)pc_back();
        } else if (wp == VK_BACK) {
            if (keyboard_visible())
                keyboard_backspace();
        } else if (wp == VK_RETURN) {
            if (keyboard_visible())
                pc_keyboard_enter();
        }
        return 0;
    case WM_KEYUP:
    case WM_SYSKEYUP:
        pc_keys[wp & 0xff] = 0;
        if (msg == WM_SYSKEYUP)
            return 0;
        return 0;
    case WM_CHAR: {
        char utf8[8];
        pc_utf8_from_wchar((WCHAR)wp, utf8, sizeof(utf8));
        if (utf8[0] && !(wp == '\r' || wp == '\n' || wp == '\b'))
            keyboard_type(utf8);
        return 0;
    }
    case WM_KILLFOCUS:
        memset(pc_keys, 0, sizeof(pc_keys));
        pc_mouse_down = 0; /* the punch is the mouse now: it must not stick */
        pc_mouse_punch = 0;
        pc_ctl_release_all();
        return 0;
    default:
        return DefWindowProcW(hwnd, msg, wp, lp);
    }
}

static int pc_run_window(PcArgs *args) {
    WNDCLASSEXW wc;
    HINSTANCE inst = GetModuleHandleW(NULL);
    RECT rc;
    MSG msg;
    int running = 1;
    SetProcessDPIAware();
    memset(&wc, 0, sizeof(wc));
    wc.cbSize = sizeof(wc);
    wc.style = CS_HREDRAW | CS_VREDRAW | CS_OWNDC;
    wc.lpfnWndProc = pc_wndproc;
    wc.hInstance = inst;
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
    wc.lpszClassName = PC_WIN_CLASS;
    if (!RegisterClassExW(&wc))
        return 2;
    rc.left = 0;
    rc.top = 0;
    rc.right = args->width;
    rc.bottom = args->height;
    AdjustWindowRect(&rc, WS_OVERLAPPEDWINDOW, FALSE);
    pc_hwnd = CreateWindowExW(0, PC_WIN_CLASS, L"Cubic Battle 4", WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT,
                              rc.right - rc.left, rc.bottom - rc.top, NULL, NULL, inst, NULL);
    if (!pc_hwnd)
        return 2;
    ShowWindow(pc_hwnd, SW_SHOW);
    UpdateWindow(pc_hwnd);
    pc_boot(args);
    if (!init_done) {
        MessageBoxA(pc_hwnd, ds_graphics_failure(), "Cubic Battle 4: renderer", MB_ICONERROR | MB_OK);
        return 2;
    }
    timeBeginPeriod(1);
    while (running && !pc_quit) {
        while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) {
            if (msg.message == WM_QUIT) {
                running = 0;
                break;
            }
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
        if (!running || pc_quit)
            break;
        pc_apply_held_input();
        (void)pc_step();
        pc_blit();
        Sleep(1);
    }
    timeEndPeriod(1);
    pc_shutdown();
    if (pc_conv) {
        free(pc_conv);
        pc_conv = NULL;
    }
    return 0;
}
